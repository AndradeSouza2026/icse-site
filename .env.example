# ICSE - Instituto Centro Social Elcimar
# Configurações de Ambiente (Desenvolvimento e Produção)

# Banco de Dados PostgreSQL (Vercel Postgres, Neon.tech, Supabase ou Render)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segredo de Sessão / JWT Admin (Troque em produção por uma chave de 32+ caracteres)
JWT_SECRET="icse-secret-super-seguro-trocar-em-producao-2026-chave-admin"

# URL base da aplicação
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Administrador inicial padrão (executado pelo seed)
SEED_ADMIN_EMAIL="admin@icse.org.br"
SEED_ADMIN_PASSWORD="Admin@ICSE2026!"
SEED_ADMIN_NAME="Administrador Geral ICSE"

